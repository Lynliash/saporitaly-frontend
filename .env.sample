# Copia questo file in ".env.local" e riempi i valori.
# Le variabili NEXT_PUBLIC_ sono lette dal browser (vanno bene per dati non segreti).
# Su Vercel: imposta le stesse variabili in Project Settings -> Environment Variables.

# URL del backend Spring.
# Locale: http://localhost:8000 | Produzione: l'URL pubblico del backend deployato.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudinary - upload immagini ricette (vedi src/lib/upload.ts per il setup).
# Cloud name: lo trovi nella Dashboard Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Upload preset con Signing Mode = Unsigned.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
